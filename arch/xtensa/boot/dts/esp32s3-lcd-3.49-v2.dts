/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/esp32s3.h>
#include <dt-bindings/reset/esp32s3.h>

/ {
	model = "Waveshare ESP32-S3-Touch-LCD-3.49 V2";
	compatible = "waveshare,esp32-s3-touch-lcd-3.49-v2",
		     "esp,esp32s3";
	#address-cells = <1>;
	#size-cells = <1>;
	interrupt-parent = <&pic>;

	aliases {
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		serial0 = &usb_serial_jtag;
	};

	chosen {
		bootargs = "earlycon";
		stdout-path = "serial0";
	};

	memory@3c300000 {
		device_type = "memory";
		reg = <0x3c300000 0x004f0000>;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			compatible = "cdns,xtensa-cpu";
			device_type = "cpu";
			reg = <0>;
			clocks = <&cpu_clk>;
		};
	};

	clocks {
		cpu_clk: cpu-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <240000000>;
		};

		xtal: xtal-clock {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <40000000>;
		};
	};

	syscon: clock-controller@600c0000 {
		compatible = "esp,esp32s3-system-controller";
		reg = <0x600c0000 0x1000>;
		clocks = <&xtal>;
		#clock-cells = <1>;
		#reset-cells = <1>;
	};

	i2c0: i2c@60013000 {
		compatible = "esp,esp32s3-i2c";
		reg = <0x60013000 0x1000>;
		clocks = <&syscon ESP32S3_CLK_I2C0>;
		resets = <&syscon ESP32S3_RST_I2C0>;
		interrupt-parent = <&intc>;
		interrupts = <42 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <400000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c0_scl_pins &i2c0_sda_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	i2c1: i2c@60027000 {
		compatible = "esp,esp32s3-i2c";
		reg = <0x60027000 0x1000>;
		clocks = <&syscon ESP32S3_CLK_I2C1>;
		resets = <&syscon ESP32S3_RST_I2C1>;
		interrupt-parent = <&intc>;
		interrupts = <43 IRQ_TYPE_LEVEL_HIGH>;
		clock-frequency = <400000>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c1_scl_pins &i2c1_sda_pins>;
		#address-cells = <1>;
		#size-cells = <0>;
	};

	intc: interrupt-controller@600c2000 {
		compatible = "esp,esp32s3-intc";
		reg = <0x600c2000 0x1000>;
		interrupt-parent = <&pic>;
		interrupts = <2 0>;
		interrupt-controller;
		#interrupt-cells = <2>;
	};

	usb_serial_jtag: serial@60038000 {
		compatible = "esp,esp32s3-usb-serial-jtag";
		reg = <0x60038000 0x1000>;
		interrupt-parent = <&intc>;
		interrupts = <96 IRQ_TYPE_LEVEL_HIGH>;
	};

	pinctrl: pinctrl@60004000 {
		compatible = "esp,esp32s3-pinctrl";
		reg = <0x60004000 0x700>, <0x60009000 0x100>;
		reg-names = "gpio", "iomux";
		interrupt-parent = <&intc>;
		interrupts = <16 IRQ_TYPE_LEVEL_HIGH>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-ranges = <&pinctrl 0 0 49>;
		gpio-reserved-ranges = <19 2>, <22 16>;
		interrupt-controller;
		#interrupt-cells = <2>;

		i2c0_scl_pins: i2c0-scl-pins {
			pins = "gpio48";
			function = "i2c0-scl";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		i2c0_sda_pins: i2c0-sda-pins {
			pins = "gpio47";
			function = "i2c0-sda";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		i2c1_scl_pins: i2c1-scl-pins {
			pins = "gpio18";
			function = "i2c1-scl";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};

		i2c1_sda_pins: i2c1-sda-pins {
			pins = "gpio17";
			function = "i2c1-sda";
			bias-pull-up;
			drive-open-drain;
			input-enable;
		};
	};

	pic: interrupt-controller {
		compatible = "cdns,xtensa-pic";
		#address-cells = <0>;
		#interrupt-cells = <2>;
		interrupt-controller;
	};
};
